#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(python3 -c 'import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "${BASH_SOURCE[0]}")"
SUBCMD="${1:-status}"
shift || true

case "$SUBCMD" in
  init)
    TARGET_DIR="${1:-.}"
    INIT_MODE="${2:-light}"
    if [[ "$TARGET_DIR" == "--light" || "$TARGET_DIR" == "--full" || "$TARGET_DIR" == "--symlink" ]]; then
      INIT_MODE="$TARGET_DIR"
      TARGET_DIR="${2:-.}"
    fi
    exec "$SCRIPT_DIR/bootstrap-repo.sh" "$TARGET_DIR" "$INIT_MODE"
    ;;
  status|--status)
    exec "$SCRIPT_DIR/bootstrap-repo.sh" --status
    ;;
  path)
    exec python3 "$SCRIPT_DIR/pstack_resolver.py" --print-paths
    ;;
  verify)
    VERIFY_MODE="${1:-all}"
    shift || true
    exec python3 "$SCRIPT_DIR/pstack-verify.py" "$VERIFY_MODE" "$@"
    ;;
  correct)
    exec python3 "$SCRIPT_DIR/pstack-correct.py" "$@"
    ;;
  pause)
    exec python3 "$SCRIPT_DIR/pstack-session.py" pause "$@"
    ;;
  pickup)
    exec python3 "$SCRIPT_DIR/pstack-session.py" pickup "$@"
    ;;
  onboard)
    exec python3 "$SCRIPT_DIR/pstack-onboard.py" "$@"
    ;;
  export)
    exec python3 "$SCRIPT_DIR/pstack-verify.py" export "$@"
    ;;
  spawn)
    exec "$SCRIPT_DIR/ag-spawn.sh" "$@"
    ;;
  update)
    exec python3 "$SCRIPT_DIR/pstack_update.py" "$@"
    ;;
  check-update)
    exec python3 "$SCRIPT_DIR/pstack_update.py" --check "$@"
    ;;
  log)
    LOG_ACTION="${1:-list}"
    shift || true
    exec python3 "$SCRIPT_DIR/log-decision.py" "$LOG_ACTION" "$@"
    ;;
  ban)
    exec python3 "$SCRIPT_DIR/pstack-verify.py" ban "$@"
    ;;
  bench)
    exec python3 "$SCRIPT_DIR/pstack-bench.py" "$@"
    ;;
  test)
    PSTACK_HOME_DIR="$(python3 "$SCRIPT_DIR/pstack_resolver.py" --pstack-home)"
    exec python3 -m unittest discover -s "$PSTACK_HOME_DIR/tests" -q "$@"
    ;;
  *)
    echo "Usage: pstack <init|status|path|verify|correct|pause|pickup|onboard|export|update|check-update|spawn|log|ban|bench|test> [args...]"
    exit 2
    ;;
esac
